APP_NAME="いろどり手帳"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=irodori
DB_USERNAME=irodori
DB_PASSWORD=irodori_local
# 開発用 MySQL の root パスワード（docker-compose.yml が読む）
DB_ROOT_PASSWORD=root_local

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----- LINE通知 -----
# 送り方：log = LINEには送らず、通知履歴とログに記録するだけ（開発用・標準）
#         line = LINE Messaging API で実際に送る（本番のサーバーで使う）
# チャネルアクセストークンとユーザーIDは、ここには書かない（アプリの「設定 → LINE連携」から登録する）
LINE_DRIVER=log
# 送る時刻を過ぎた通知を、何分後まで送るか（サーバーが少し止まっていたとき用。これより遅れたものは見送る）
LINE_GRACE_MINUTES=30
# 月の送信数の上限（無料プランは200通。0 = 上限なし）。LINE から上限を取れたときは、そちらを使う
LINE_MONTHLY_LIMIT=200
# 上限の手前の余裕。「上限 − 余裕」（無料プランなら180通）に達したら、完了まで再通知を止める
LINE_REMINDER_MARGIN=20
