# 本番（AWS EC2）用の Laravel の .env の見本。秘密の値は空欄のまま。Git に入れてよいのはこの見本だけ
#   サーバーで：cp .env.production.example .env → chmod 600 .env → 空欄を埋める（手順は docs/aws-deploy.md）
#   docker-compose.prod.yml もこの .env を読む（DB_* と APP_UID / APP_GID）
#
# ※ APP_ENV・APP_DEBUG・SESSION_SECURE_COOKIE・LINE_DRIVER は docker-compose.prod.yml の environment で固定している。
#   ここに別の値を書いても、本番用のコンテナでは使われない（下の値は確認用）

APP_NAME="いろどり手帳"
APP_ENV=production
# 空欄のままにして、サーバーで作る：docker compose -p irodori-prod -f docker-compose.prod.yml run --rm app php artisan key:generate
# ・作り直すと、ログイン中の人は全員ログアウトし、保存した LINE のトークンも読めなくなる → 一度作ったら変えない
# ・チャットや Git に貼らない。控えは EC2 の外の安全な場所（パスワード管理アプリなど）に
APP_KEY=
APP_DEBUG=false
APP_URL=https://irodori.example.com

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ログは storage/logs/ に1日1ファイル、14日分だけ残す（ディスクがいっぱいにならないように）
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# MySQL（docker-compose.prod.yml の db コンテナ。サーバーの外には公開しない）
#   パスワードはサーバーで作る（英数字だけにする。記号は Compose が別の意味に読むことがある）：openssl rand -hex 24
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=irodori
DB_USERNAME=irodori
DB_PASSWORD=
DB_ROOT_PASSWORD=

# PHP と node を動かすユーザー（git clone したユーザー）。ec2-user なら 1000 のまま。確かめ方：id -u / id -g
APP_UID=1000
APP_GID=1000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# 空のまま（Cookie をこのドメインだけに送る）
SESSION_DOMAIN=
# HTTPS（CloudFront）でだけ Cookie を送る
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# メールは使わない（送らずにログへ）
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ----- LINE通知 -----
# docker-compose.prod.yml が LINE_DRIVER=line に固定している（LINE連携を登録した人に実際に送る。ここの値は使われない）
# （アプリを受け取った人が自分のサーバーで実際に送るときの手順は README.md の「LINE通知」）
LINE_DRIVER=line
LINE_GRACE_MINUTES=30
LINE_MONTHLY_LIMIT=200
LINE_REMINDER_MARGIN=20
