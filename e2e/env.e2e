# ブラウザテスト（e2e）専用の .env の見本（秘密の値は入れない）
# e2e/run.sh が APP_KEY をランダムに作って e2e/.runtime/.env に書き出し、
# docker-compose.e2e.yml がそれをテスト用コンテナの /var/www/html/.env に重ねる
# → テスト用コンテナからは、開発用の .env（MySQL の接続先など）が見えない
APP_NAME="いろどり手帳（E2E）"
APP_ENV=e2e
APP_KEY=
APP_DEBUG=false
APP_URL=http://app-day:8000
APP_LOCALE=ja
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# DB はテスト専用の SQLite だけ。シナリオごとのファイルは docker-compose.e2e.yml の DB_DATABASE で指定する
# （環境変数が渡らなかったときは、存在しないファイルを指すので、どこにも接続できずに止まる）
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/e2e/.runtime/not-configured.sqlite
# MySQL を選んでしまっても、つながらない名前にしておく
DB_HOST=e2e-no-mysql
DB_PORT=3306
DB_USERNAME=e2e
DB_PASSWORD=e2e

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# LINE はシミュレーション（LINE には送らない）
LINE_DRIVER=log
