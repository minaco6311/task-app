# テスト用 MySQL（tests/mysql/run.sh）専用の .env の見本（秘密の値は入れない）
# run.sh が APP_KEY をランダムに作って tests/mysql/.runtime/.env に書き出し、テスト用コンテナの .env に重ねる
APP_NAME="いろどり手帳（MySQL テスト）"
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=ja
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=mysqltest-db
DB_PORT=3306
DB_DATABASE=irodori_test
DB_USERNAME=irodori_test
DB_PASSWORD=irodori_test_only
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
LINE_DRIVER=log
